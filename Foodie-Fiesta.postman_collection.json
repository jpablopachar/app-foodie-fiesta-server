  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const path = pm.request.url.getPath();",
          "const loginTokens = {",
          "  '/api/user/register': 'userToken',",
          "  '/api/user/login': 'userToken',",
          "  '/api/user/admin': 'admin-token'",
          "};",
          "if (loginTokens[path]) {",
          "  pm.collectionVariables.unset(loginTokens[path]);",
          "}",
          "const tokenHeader = pm.request.headers.get('token');",
          "const tokenKey = tokenHeader === '{{userToken}}' ? 'userToken'",
          "  : tokenHeader === '{{admin-token}}' ? 'admin-token' : null;",
          "if (tokenKey) {",
          "  const token = pm.collectionVariables.get(tokenKey);",
          "  if (typeof token !== 'string' || !token.trim()) {",
          "    const message = 'Falta ' + tokenKey + '. Ejecute primero el inicio de sesión correspondiente.';",
          "    console.error(message);",
          "    pm.execution.skipRequest();",
          "    throw new Error(message);",
          "  }",
          "  pm.request.headers.upsert({ key: 'token', value: token });",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const loginTokens = {",
          "  '/api/user/register': 'userToken',",
          "  '/api/user/login': 'userToken',",
          "  '/api/user/admin': 'admin-token'",
          "};",
          "const tokenKey = loginTokens[pm.request.url.getPath()];",
          "if (tokenKey) {",
          "  pm.collectionVariables.unset(tokenKey);",
          "  pm.test('Autenticación correcta y JWT guardado en ' + tokenKey, function () {",
          "    pm.response.to.have.status(200);",
          "    const body = pm.response.json();",
          "    pm.expect(body).to.have.property('success', true);",
          "    pm.expect(body.token).to.be.a('string');",
          "    pm.expect(body.token).to.match(/^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$/);",
          "    pm.collectionVariables.set(tokenKey, body.token);",
          "  });",
          "}"
        ]
      }
    }
